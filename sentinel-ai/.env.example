# ── SENTINEL-AI Environment Variables ──
# Copy this file to .env and fill in your API keys.
# In DEMO_MODE, the system works without any keys.

CEREBRAS_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Storage paths
SENTINEL_DB_PATH=./sentinel.duckdb
SENTINEL_CHROMA_PATH=./chroma_db

# Ingestion
SENTINEL_REPLAY_RATE=5

# Demo mode: uses stub enrichment and mock LLM if API keys are missing
SENTINEL_DEMO_MODE=true
